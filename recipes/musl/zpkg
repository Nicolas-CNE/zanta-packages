PKG_NAME="musl"
PKG_VER="1.2.6"
PKG_CAT="lib-musl"
PKG_DESC="musl C standard library - Fuente oficial"

package_binary() {
    echo "  -> Descargando código fuente oficial de musl v$PKG_VER..."
    wget -q "https://musl.libc.org/releases/musl-$PKG_VER.tar.gz" -O musl-$PKG_VER.tar.gz
    tar -xzf musl-$PKG_VER.tar.gz
    cd musl-$PKG_VER

    echo "  -> Configurando y compilando musl..."
    # --prefix=/usr instala bibliotecas y headers en /usr/lib y /usr/include
    # --syslibdir=/lib coloca el dynamic linker (ld-musl-x86_64.so.1) en /lib
    ./configure --prefix=/usr --syslibdir=/lib CFLAGS="-O2 -pipe"
    make -j$(nproc)

    echo "  -> Instalando binarios y librerías en $PKG_DEST..."
    make DESTDIR="$PKG_DEST" install
}
